{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "types": ["bun"],
    "paths": {
      "sagaflow-js": ["./src/index.ts"],
      "sagaflow-js/memory": ["./src/memory/index.ts"],
      "sagaflow-js/testing": ["./src/testing/index.ts"],
      "sagaflow-js/sql": ["./src/sql/index.ts"],
      "sagaflow-js/d1": ["./src/d1/index.ts"],
      "sagaflow-js/sqlite": ["./src/sqlite/index.ts"],
      "sagaflow-js/cloudflare": ["./src/cloudflare/index.ts"]
    }
  },
  "include": ["src", "test", "test-workerd", "vitest.config.ts"]
}
