{
  "name": "sagaflow-js",
  "version": "0.1.3",
  "description": "Sagas for TypeScript — compensating workflows that run inline in a request or durably on a workflow engine. Cloudflare Workflows adapter included.",
  "keywords": [
    "cloudflare-workflows",
    "compensation",
    "durable-execution",
    "idempotency",
    "orchestration",
    "outbox",
    "saga",
    "typescript",
    "workflow"
  ],
  "homepage": "https://github.com/bayraak/sagaflow#readme",
  "bugs": "https://github.com/bayraak/sagaflow/issues",
  "license": "MIT",
  "author": "Bayram Ali Basgul",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bayraak/sagaflow.git"
  },
  "bin": {
    "sagaflow": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./sql": {
      "types": "./dist/sql/index.d.ts",
      "default": "./dist/sql/index.js"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "default": "./dist/memory/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite/index.d.ts",
      "default": "./dist/sqlite/index.js"
    },
    "./d1": {
      "types": "./dist/d1/index.d.ts",
      "default": "./dist/d1/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare/index.d.ts",
      "default": "./dist/cloudflare/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run schema && tsc -p tsconfig.build.json && cp src/sql/schema.sql dist/sql/schema.sql",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "bench": "tsc -p bench/tsconfig.json --noEmit && bun run bench/index.ts",
    "lint": "oxlint src test test-workerd examples scripts bench",
    "schema": "bun scripts/write-schema.ts",
    "test": "bun test",
    "test:examples": "bun test --cwd examples bun-inline with-valibot agent-tools",
    "test:workerd": "vitest run",
    "test:example-worker": "vitest run --root examples/cloudflare-worker",
    "test:properties": "bun test test/properties",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.examples.json --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260819.1",
    "@types/bun": "1.2.22",
    "fast-check": "4.9.0",
    "mitata": "1.0.34",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "typescript": "^7.0.2",
    "valibot": "^1.1.0",
    "vitest": "^4.1.11",
    "wrangler": "4.124.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": ">=4"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
