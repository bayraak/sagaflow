{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "semi": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "tabWidth": 2,
  "useTabs": false,
  "quoteProps": "as-needed",
  "sortImports": true,
  "sortPackageJson": true,
  "ignorePatterns": ["dist", "node_modules", ".wrangler", "*.yaml", "*.yml"],
}
